{
  // Type-checks the spec-parity tests, which the package tsconfigs cannot.
  //
  // Every package's own tsconfig excludes `**/*.test.ts`, so a `type-check`
  // script never compiles a test file. That is fine for behavioural tests, but
  // the spec-parity tests carry their claims as TYPES — `Assert<Equal<Local,
  // Spec>>` is a compile error or it is nothing. Without this project they
  // would be exactly the "declared but not enforced" landmine objectstack#4115
  // exists to remove, sitting inside the guard for it.
  //
  // Scope is deliberately narrow: only the files whose assertions are known to
  // compile against the repo root's path mapping. Add a file here when you add
  // compile-time pins to it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/auth/src/__tests__/auth-spec-parity.test.ts",
    "packages/components/src/__tests__/share-filter-sort-spec-parity.test.ts",
    "packages/react/src/hooks/__tests__/offline-nav-performance-spec-parity.test.ts"
  ]
}
