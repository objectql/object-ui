{
  "type": "dashboard",
  "title": "Sales Overview",
  "columns": 2,
  "gap": 4,
  "dateRange": {
    "field": "created_at",
    "defaultRange": "last_30_days",
    "allowCustomRange": true
  },
  "globalFilters": [
    {
      "name": "region",
      "field": "region",
      "label": "Region",
      "type": "select",
      "options": [
        { "value": "EMEA", "label": "EMEA" },
        { "value": "APAC", "label": "APAC" },
        { "value": "AMER", "label": "AMER" }
      ]
    }
  ],
  "widgets": [
    {
      "id": "invoices_by_status",
      "title": "Invoices by Status",
      "type": "bar",
      "options": {
        "xField": "status",
        "yField": "count",
        "data": [
          { "status": "Draft", "count": 18 },
          { "status": "Sent", "count": 31 },
          { "status": "Paid", "count": 47 },
          { "status": "Void", "count": 4 }
        ]
      }
    },
    {
      "id": "accounts_signed",
      "title": "Accounts Signed",
      "type": "line",
      "options": {
        "xField": "month",
        "yField": "count",
        "data": [
          { "month": "Jan", "count": 6 },
          { "month": "Feb", "count": 9 },
          { "month": "Mar", "count": 14 },
          { "month": "Apr", "count": 11 },
          { "month": "May", "count": 17 },
          { "month": "Jun", "count": 21 }
        ]
      },
      "filterBindings": {
        "dateRange": "signed_at",
        "region": "sales_region"
      }
    },
    {
      "id": "total_invoices",
      "title": "Total Invoices (all regions)",
      "type": "metric",
      "options": {
        "value": "1,284"
      },
      "filterBindings": {
        "region": false
      }
    }
  ]
}
